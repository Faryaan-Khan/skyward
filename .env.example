# All optional for local use: without them the app runs on SQLite + synthetic data.

# Shared Postgres database (production). Example from Neon:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=

# Live fares: Travelpayouts -> Profile -> API token. Marker = your affiliate ID (optional).
TRAVELPAYOUTS_TOKEN=
TRAVELPAYOUTS_MARKER=

# Protects admin endpoints (/api/watches/check, /api/admin/reload-model)
ADMIN_TOKEN=

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
TELEGRAM_BOT_TOKEN=
